<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://tizen.local/SOVideoPlayer" version="1.1.0" viewmodes="maximized">
    <tizen:application id="SOVidPlay0.SOVideoPlayer" package="SOVidPlay0" required_version="2.3"/>
    <content src="index.html"/>
    <name>SO Regelvideos</name>
    <icon src="icon.png"/>

    <!-- Zugriff auf spiele-offensive.de und den Medienserver (Bilder/MP4) ohne CORS-Beschraenkung -->
    <access origin="https://www.spiele-offensive.de" subdomains="true"/>
    <access origin="https://spiele-offensive.de" subdomains="true"/>
    <access origin="https://mediaservice.happyshops.com" subdomains="true"/>

    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:profile name="tv"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
